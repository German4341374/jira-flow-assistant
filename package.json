{
  "name": "jira-flow-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "mock": "node --experimental-strip-types apps/mock-jira/server.ts",
    "build": "vite build && node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run e2e"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.6",
    "@types/chrome": "0.1.43",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "prettier": "3.9.10"
  }
}
